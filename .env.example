# Telegram API credentials (MTProto — for the user account that owns/trades the gifts)
# Get these from https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot API token (control panel bot) — from @BotFather
TELEGRAM_BOT_TOKEN=

# Web dashboard / login page.
# WEB_PORT is only used if PORT isn't set — most platforms (Railway included)
# inject PORT themselves, so you normally don't need to set either locally
# beyond this default. WEB_PUBLIC_URL must be the real deployed URL in
# production (e.g. https://your-app.up.railway.app) — it's what the bot's
# "🔐 Login qilish" button links to.
WEB_PORT=3001
WEB_PUBLIC_URL=http://localhost:3000

# SQLite database file (kept out of git — see .gitignore).
# In production, point this at a persistent volume mount, e.g. /data/app.db
# (see README "Deploying to Railway") — otherwise it's wiped on every deploy.
DATABASE_PATH=./data/app.db

# Where the encrypted MTProto session string is persisted (kept out of git).
# Same rule as DATABASE_PATH: needs to be on a persistent volume in production.
SESSION_FILE_PATH=./data/telegram.session

# Key used to encrypt the saved Telegram session at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Telegram user id of the admin — the only person who can approve other
# users (/adduser, /removeuser, /users). Always counts as approved. Find your
# id via @userinfobot. Set the same key in Railway -> portal-bot -> Variables.
ADMIN_TELEGRAM_ID=
