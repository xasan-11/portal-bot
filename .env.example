# Telegram API credentials (MTProto — for the user account that owns/trades the gifts)
# Get these from https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot API token (control panel bot) — from @BotFather
TELEGRAM_BOT_TOKEN=

# Web dashboard / login page
WEB_PORT=3001
WEB_PUBLIC_URL=http://localhost:3000

# SQLite database file (kept out of git — see .gitignore)
DATABASE_PATH=./data/app.db

# Where the encrypted MTProto session string is persisted (kept out of git)
SESSION_FILE_PATH=./data/telegram.session

# Key used to encrypt the saved Telegram session at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
