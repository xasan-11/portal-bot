{
  "name": "nft-offer-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram collectible gift (NFT) offer automation — bot control panel + web dashboard",
  "type": "commonjs",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "npm run dev -w client",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/database/schema.sql','dist/database/schema.sql')\"",
    "build:client": "npm run build -w client",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "big-integer": "^1.6.52",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "telegraf": "^4.16.3",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
